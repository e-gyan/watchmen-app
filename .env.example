# ==============================================================================
# Watchman Prayer & Accountability Partner App - Environment Variables Template
# Copy this file to .env for local testing. NEVER commit your actual .env file!
# ==============================================================================

# Node Environment
NODE_ENV="production"
PORT=10000

# GEMINI_API_KEY: (Secret) Required for server-side spiritual scripture & encouragement generation.
# Stored securely on the server; never exposed to the client browser.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The public URL where this app is hosted (e.g., https://your-app.onrender.com).
# Used for OAuth callbacks, CORS validation, and self-referential links.
APP_URL="https://your-app.onrender.com"

