{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for prayer tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Partnership": {
      "title": "Partnership",
      "description": "Accountability covenant for individual private space or shared prayer partners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "circleType": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "memberEmails": { "type": "array" },
        "memberNames": { "type": "array" },
        "dailyTargetMinutes": { "type": "number" },
        "weeklyTargetMinutes": { "type": "number" },
        "periodTitle": { "type": "string", "maxLength": 128 },
        "periodTargetMinutes": { "type": "number" },
        "periodStartDate": { "type": "string", "maxLength": 32 },
        "periodEndDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdBy", "memberUids", "memberEmails", "dailyTargetMinutes", "weeklyTargetMinutes", "periodTargetMinutes"]
    },
    "PrayerSession": {
      "title": "PrayerSession",
      "description": "Individual or joint prayer encounter logged by a member of the partnership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "maxLength": 32 },
        "durationMinutes": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "topics": { "type": "array" },
        "notes": { "type": "string", "maxLength": 4096 },
        "scripture": { "type": "string", "maxLength": 256 },
        "participantNames": { "type": "array" },
        "wasTogether": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorUid", "authorName", "date", "durationMinutes", "category", "notes"]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "Permanent memorial of God's answered prayer within the partnership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "prayerBurden": { "type": "string", "maxLength": 2048 },
        "answeredDetail": { "type": "string", "maxLength": 4096 },
        "scripturePraise": { "type": "string", "maxLength": 256 },
        "amensCount": { "type": "number" },
        "amenUids": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorUid", "authorName", "title", "date", "category", "prayerBurden", "answeredDetail"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Active intercessory request on the altar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "dateAdded": { "type": "string", "maxLength": 32 },
        "assignedPartner": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 2048 },
        "answeredTestimonyId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorUid", "authorName", "title", "status", "category", "dateAdded"]
    },
    "MessageListeningRecord": {
      "title": "MessageListeningRecord",
      "description": "Record of hours and minutes spent listening to a spiritual message, supporting repeats and time additions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "speaker": { "type": "string", "maxLength": 128 },
        "durationMinutes": { "type": "number" },
        "initialDurationMinutes": { "type": "number" },
        "listenCount": { "type": "number" },
        "date": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 2048 },
        "wasTogether": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorUid", "authorName", "title", "durationMinutes", "date"]
    },
    "AuthorityFigureSeed": {
      "title": "AuthorityFigureSeed",
      "description": "Authority figure specification with year-end seed target amount",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "authorityName": { "type": "string", "maxLength": 128 },
        "roleTitle": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "maxLength": 16 },
        "yearTargetAmount": { "type": "number" },
        "targetYear": { "type": "string", "maxLength": 16 },
        "mode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorUid", "authorityName", "yearTargetAmount", "mode"]
    },
    "SeedGivingRecord": {
      "title": "SeedGivingRecord",
      "description": "Individual or partner seed offering given to a specified authority figure",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "partnershipId": { "type": "string", "maxLength": 128 },
        "authorityId": { "type": "string", "maxLength": 128 },
        "authorityName": { "type": "string", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 32 },
        "mode": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnershipId", "authorityId", "authorityName", "authorUid", "amount", "date", "mode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles indexed by UID"
    },
    "/partnerships/{partnershipId}": {
      "schema": "Partnership",
      "description": "Prayer accountability partnerships and covenant targets"
    },
    "/partnerships/{partnershipId}/sessions/{sessionId}": {
      "schema": "PrayerSession",
      "description": "Documented prayer encounters and minutes logged"
    },
    "/partnerships/{partnershipId}/testimonies/{testimonyId}": {
      "schema": "Testimony",
      "description": "Praise reports and answered prayers"
    },
    "/partnerships/{partnershipId}/requests/{requestId}": {
      "schema": "PrayerRequest",
      "description": "Active intercession requests on the altar"
    },
    "/partnerships/{partnershipId}/messages/{messageId}": {
      "schema": "MessageListeningRecord",
      "description": "Message listening records with title, duration, and date"
    },
    "/partnerships/{partnershipId}/authorities/{authorityId}": {
      "schema": "AuthorityFigureSeed",
      "description": "Authority figures and their year-end seed target amounts"
    },
    "/partnerships/{partnershipId}/seeds/{seedId}": {
      "schema": "SeedGivingRecord",
      "description": "Seeds sown toward specified authority figures"
    }
  }
}
